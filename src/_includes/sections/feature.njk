{% from "sections/_macros.njk" import arrow %}
{#- Compact highlighted feature callout (eyebrow / title / text / link). -#}
<section class="section" id="{{ s.id }}" data-label="{{ s.eyebrow or s.title or s.id }}"><div class="container">
  <div class="feature">
    {%- if s.eyebrow %}<p class="eyebrow">{{ s.eyebrow }}</p>{% endif %}
    <h2 class="feature__title">{{ s.title }}</h2>
    {%- if s.text %}<p class="feature__text">{{ s.text }}</p>{% endif %}
    {%- if s.link %}<a class="link-more" href="{{ s.link.href }}">{{ s.link.label }} {{ arrow() }}</a>{% endif %}
  </div>
</div></section>

{# Shared bits reused across section partials. #}
{% macro arrow() %}<svg class="arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>{% endmacro %}

{# Standard section header: optional eyebrow + title. #}
{% macro shead(s) %}{% if s.eyebrow or s.title %}<div class="section-head">{% if s.eyebrow %}<p class="eyebrow">{{ s.eyebrow }}</p>{% endif %}{% if s.title %}<h2 class="section-title">{{ s.title }}</h2>{% endif %}</div>{% endif %}{% endmacro %}
